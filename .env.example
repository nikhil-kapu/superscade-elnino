# --- LLM (OpenAI chat completions; MOCK_LLM=1 runs without a key) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini         # district planners
OPENAI_MODEL_BIG=                 # chief / verifier / reflector (defaults to OPENAI_MODEL)
OPENAI_MODEL_SMALL=gpt-4.1-nano   # helpers
MOCK_LLM=
PORT=8787
LOCK_REGION=            # e.g. bayarea: hide and refuse other regions during a demo

# --- Terse durable actors (local runtime: cd actors && bunx terse-cli@latest actor dev) ---
TERSE_ACTOR_URL=http://127.0.0.1:7100/v1/projects/local/actors
TERSE_API_KEY=            # only for a cloud deployment (terse deploy)
TERSE_TIMEOUT_MS=5000
TERSE_DISABLED=           # 1 = skip Terse entirely

# --- Agent Relay (fresh workspace per boot; 40 standing agent identities pre-registered) ---
RELAY_BASE_URL=           # e.g. http://localhost:8789 for a self-hosted @relaycast/engine; empty = hosted Relaycast
RELAY_WORKSPACE_KEY=      # optional: reuse a specific workspace
RELAY_DISABLED=           # 1 = skip Agent Relay entirely
RELAY_HELPER_IDENTITIES=  # 1 = register every helper as its own relay agent
RELAY_CHANNEL=elnino-storm

# --- Phone calls: simulated unless explicitly enabled ---
ALLOW_REAL_CALLS=         # 1 = allow real Twilio dialing (also needs the per-run opt-in)
CALLS_PROVIDER=simulated
EMERGENCY_CONTACT_PHONE=
